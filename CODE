from machine import Pin, PWM, ADC
import utime

sensors = [ADC(Pin(pin)) for pin in [26, 27, 28]]
threshold = 4000
weights = [1, 0, -1]
output = 0
baseSpeed = 120
drive = 0  # Start stopped until button is pressed

AIN1 = PWM(Pin(11), freq=1000)
AIN2 = PWM(Pin(10), freq=1000)
BIN1 = PWM(Pin(9), freq=1000)
BIN2 = PWM(Pin(8), freq=1000)

btn = Pin(20, Pin.IN, Pin.PULL_UP)  # GP20 button with internal pull-up
last_btn_state = 1  # Pull-up means unpressed = HIGH

def motor_drive(PIDvalue):
    right = baseSpeed + PIDvalue
    left  = baseSpeed - PIDvalue

    if drive == 1:
        if right > 0:
            AIN1.duty_u16(int(right * 257))
            AIN2.duty_u16(0)
        else:
            AIN1.duty_u16(0)
            AIN2.duty_u16(int(abs(right) * 257))

        if left > 0:
            BIN1.duty_u16(int(left * 257))
            BIN2.duty_u16(0)
        else:
            BIN1.duty_u16(0)
            BIN2.duty_u16(int(abs(left) * 257))
    else:
        AIN1.duty_u16(0)
        AIN2.duty_u16(0)
        BIN1.duty_u16(0)
        BIN2.duty_u16(0)

def sensorRead(output):
    global drive
    values = [sensor.read_u16() for sensor in sensors]
    count = 0
    for i in range(3):
        if values[i] > threshold:
            count += 1
            output = weights[i]
    if count == 3:
        drive = 0  # Stop if all 3 sensors triggered (end of line)
    print(values, count, drive)
    return output

def check_button():
    global drive, last_btn_state
    current = btn.value()
    if last_btn_state == 1 and current == 0:  # Falling edge = button pressed
        drive = 1 - drive                      # Toggle drive on/off
        print("Button pressed — drive:", drive)
        utime.sleep_ms(200)                    # Debounce
    last_btn_state = current

while True:
    check_button()
    output = sensorRead(output)
    motor_drive(output * 100)
    utime.sleep(0.05)
